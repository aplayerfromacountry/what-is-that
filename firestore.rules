rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny all paths by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
             data.email is string && data.email.size() <= 200 &&
             (!('name' in data) || (data.name is string && data.name.size() <= 100)) &&
             (!('role' in data) || (data.role in ['user', 'admin'])) &&
             (!('isAdmin' in data) || (data.isAdmin is bool));
    }

    function isValidReading(data) {
      return data.id is string && isValidId(data.id) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.type in ['tu-vi', 'natal-chart', 'tarot', 'kinh-dich'] &&
             data.title is string && data.title.size() <= 200 &&
             data.resultMarkdown is string && data.resultMarkdown.size() <= 100000 &&
             (!('question' in data) || (data.question is string && data.question.size() <= 1000)) &&
             (!('timestamp' in data) || (data.timestamp is number)) &&
             (!('summary' in data) || (data.summary is string && data.summary.size() <= 1000));
    }

    function isValidPlantGarden(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.selectedTreeId is string && data.selectedTreeId.size() <= 64 &&
             data.level is number && data.level >= 1 && data.level <= 5 &&
             data.currentExp is number && data.currentExp >= 0 &&
             (!('waterCount' in data) || (data.waterCount is number && data.waterCount >= 0)) &&
             (!('weedCount' in data) || (data.weedCount is number && data.weedCount >= 0));
    }

    function isValidDriveBackup(data) {
      return data.id is string && isValidId(data.id) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.driveFileId is string && data.driveFileId.size() <= 200 &&
             data.fileName is string && data.fileName.size() <= 255 &&
             data.backupType in ['full', 'reading', 'plant-diary', 'music', 'astro-chart'] &&
             (!('webViewLink' in data) || (data.webViewLink is string && data.webViewLink.size() <= 500));
    }

    function isValidAstroChart(data) {
      return data.id is string && isValidId(data.id) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.type in ['tu-vi', 'natal-chart'] &&
             data.title is string && data.title.size() <= 200 &&
             (!('fullName' in data) || (data.fullName is string && data.fullName.size() <= 100)) &&
             (!('birthDate' in data) || (data.birthDate is string && data.birthDate.size() <= 50)) &&
             (!('birthHour' in data) || (data.birthHour is string && data.birthHour.size() <= 50)) &&
             (!('calendarType' in data) || (data.calendarType in ['solar', 'lunar'])) &&
             (!('gender' in data) || (data.gender is string && data.gender.size() <= 20)) &&
             (!('birthPlace' in data) || (data.birthPlace is string && data.birthPlace.size() <= 150)) &&
             (!('chartImageUrl' in data) || (data.chartImageUrl is string && data.chartImageUrl.size() <= 500000)) &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 2000));
    }

    function isValidUserMusicTrack(data) {
      return data.id is string && isValidId(data.id) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 200 &&
             (!('artist' in data) || (data.artist is string && data.artist.size() <= 100)) &&
             (!('duration' in data) || (data.duration is number)) &&
             (!('fileSize' in data) || (data.fileSize is string && data.fileSize.size() <= 50)) &&
             (!('mimeType' in data) || (data.mimeType is string && data.mimeType.size() <= 50)) &&
             (!('driveFileId' in data) || (data.driveFileId is string && data.driveFileId.size() <= 200)) &&
             (!('driveUrl' in data) || (data.driveUrl is string && data.driveUrl.size() <= 500));
    }

    // Diagnostic/Connection test path
    match /test/{docId} {
      allow read: if isSignedIn();
    }

    // User Profile Documents
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) &&
                    incoming().userId == existing().userId;
      allow delete: if isOwner(userId);

      // User Readings & Divination History
      match /readings/{readingId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(readingId) && isValidReading(incoming());
        allow update: if isOwner(userId) && isValidId(readingId) && isValidReading(incoming()) &&
                      incoming().userId == existing().userId && incoming().id == existing().id;
        allow delete: if isOwner(userId) && isValidId(readingId);
      }

      // User Mind Plant Garden
      match /plantGarden/{gardenId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(gardenId) && isValidPlantGarden(incoming());
        allow update: if isOwner(userId) && isValidId(gardenId) && isValidPlantGarden(incoming()) &&
                      incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(gardenId);
      }

      // User Google Drive Backups Log
      match /driveBackups/{backupId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(backupId) && isValidDriveBackup(incoming());
        allow update: if isOwner(userId) && isValidId(backupId) && isValidDriveBackup(incoming()) &&
                      incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(backupId);
      }

      // User Astrological Charts (Tu Vi & Natal Chart)
      match /charts/{chartId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(chartId) && isValidAstroChart(incoming());
        allow update: if isOwner(userId) && isValidId(chartId) && isValidAstroChart(incoming()) &&
                      incoming().userId == existing().userId && incoming().id == existing().id;
        allow delete: if isOwner(userId) && isValidId(chartId);
      }

      // User Music Tracks Catalogue
      match /musicTracks/{trackId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(trackId) && isValidUserMusicTrack(incoming());
        allow update: if isOwner(userId) && isValidId(trackId) && isValidUserMusicTrack(incoming()) &&
                      incoming().userId == existing().userId && incoming().id == existing().id;
        allow delete: if isOwner(userId) && isValidId(trackId);
      }
    }
  }
}
